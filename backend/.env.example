# Database
DATABASE_URL=postgresql://chamcong:chamcong_dev@localhost:5432/chamcong

# Server
PORT=3000

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Webhook (used in T17 - webhook authentication, not needed for initial setup)
WEBHOOK_SECRET=your-webhook-secret-change-in-production

# Seed script (prisma/seed.ts) - optional, all have sane defaults. If
# SEED_ADMIN_PASSWORD is left unset, a random password is generated and
# printed to the console the first time the seed script creates the admin.
# SEED_ADMIN_EMAIL=admin@chamcong.local
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Admin
